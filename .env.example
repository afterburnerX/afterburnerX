# Public base URL of this site, no trailing slash. Used to build the
# public URL for uploaded images that gets handed to the Graph API -
# set this explicitly if the app runs behind a proxy/load balancer.
APP_URL=https://yourdomain.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=afterburnerx
DB_USER=root
DB_PASS=

# Meta for Developers > your app > Settings > Basic
FB_APP_ID=your_facebook_app_id
FB_APP_SECRET=your_facebook_app_secret
# Must exactly match a "Valid OAuth Redirect URI" configured on the Facebook Login product
FB_REDIRECT_URI=https://yourdomain.com/facebook-callback.php

# console.anthropic.com > API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-5

# --- Email (token-expiry reminders, cron/send_expiry_reminders.php) ---
# Leave SMTP_HOST blank to fall back to PHP's mail() function.
MAIL_FROM=no-reply@yourdomain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# tls (STARTTLS, typically port 587), ssl (implicit TLS, typically port 465), or none
SMTP_ENCRYPTION=tls
# Verify the SMTP server's TLS certificate. Leave true unless you're
# connecting to a relay behind a private/internal CA - setting false
# makes the connection MITM-able.
SMTP_VERIFY_PEER=true

# --- Upload storage ---
# local (default): saved under public/uploads/, served from this server.
# s3: any S3-compatible object store (AWS S3, Cloudflare R2, DigitalOcean
# Spaces, MinIO, ...) - required once you run more than one app server,
# since local disk uploads aren't shared between them.
STORAGE_DRIVER=local
# e.g. https://s3.us-east-1.amazonaws.com, https://<account>.r2.cloudflarestorage.com,
# https://nyc3.digitaloceanspaces.com, or your MinIO endpoint.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set true for providers/setups that need path-style URLs (endpoint/bucket/key)
# instead of virtual-hosted-style (bucket.endpoint/key), e.g. most MinIO setups.
S3_PATH_STYLE=false
# Optional: public URL prefix to use instead of the raw S3 endpoint, e.g. a
# CDN domain or the bucket's public web endpoint. Leave blank to use the
# endpoint URL directly.
S3_PUBLIC_URL_BASE=
