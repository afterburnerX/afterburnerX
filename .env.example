# Public base URL of this site, no trailing slash. Used to build the
# public URL for uploaded images that gets handed to the Graph API -
# set this explicitly if the app runs behind a proxy/load balancer.
APP_URL=https://yourdomain.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=afterburnerx
DB_USER=root
DB_PASS=

# Meta for Developers > your app > Settings > Basic
FB_APP_ID=your_facebook_app_id
FB_APP_SECRET=your_facebook_app_secret
# Must exactly match a "Valid OAuth Redirect URI" configured on the Facebook Login product
FB_REDIRECT_URI=https://yourdomain.com/facebook-callback.php

# console.anthropic.com > API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-5
