# Safety net if the web server's document root is ever pointed at the
# repository root instead of /public: deny everything here, and let
# public/.htaccess explicitly re-allow that one directory.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
