# Uploaded images only - never execute scripts from this directory.
<FilesMatch "\.(php|phtml|php\d|pl|py|cgi|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes -ExecCGI
